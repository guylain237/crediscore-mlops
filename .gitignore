# Terraform
# ATTENTION : un .gitignore n'accepte PAS de commentaire en fin de ligne.
# Tout ce qui suit le motif ferait partie du motif — et ne filtrerait plus rien.
# Les commentaires vont donc systématiquement sur leur propre ligne.

# État de l'infrastructure : sensible, et stocké dans S3 (voir infra/backend.tf)
*.tfstate
*.tfstate.*

# Cache des providers téléchargés — régénéré par `terraform init`
.terraform/

# Peut contenir des secrets ; un gabarit est fourni en .tfvars.example
*.tfvars

# Contient le numéro de compte AWS ; gabarit en backend.hcl.example
backend.hcl

# Plans enregistrés par `terraform plan -out=tfplan` : valeurs sensibles,
# non rejouables ailleurs
tfplan
*.tfplan

# .terraform.lock.hcl est VOLONTAIREMENT versionné : il fige les versions et
# empreintes exactes des providers, exactement comme requirements.lock.txt le
# fait pour Python. L'ignorer, c'est perdre la reproductibilité que l'on exige
# par ailleurs du côté Python.

# Données
*.csv
*.zip
*.parquet

# La barre oblique initiale ANCRE le motif à la racine : sans elle, « data/ »
# ignorerait aussi un futur pipelines/data/ ou api/data/, qui sont du code.
/data/

# Sorties locales du pipeline (zones clean/ et curated/ en développement).
# Elles se régénèrent en rejouant les jobs ; leur équivalent de production vit
# dans le data lake S3.
/donnees_pipeline/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Airflow (exécution locale)
airflow/logs/
airflow/*.db
airflow/*.pid
logs/

# Secrets
.env
*.pem
*.key
secrets/

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Notes personnelles — contiennent des valeurs réelles (n° de compte, buckets).
# La documentation destinée au dépôt est dans docs/.
MEMO-PERSO.md
*.perso.md

# Notes de travail et supports de présentation, strictement privés : ils ne
# font pas partie du dépôt et ne doivent jamais être publiés.
PERSO-*
