# Gabarit des variables de la pile — copier en .env SUR LA VM et remplir.
# Le fichier .env réel n'est jamais versionné (voir .gitignore).
#
#   cp .env.example .env && nano .env
#
# Les mots de passe ci-dessous protègent des interfaces qui ne sont joignables
# que depuis l'IP administrateur (groupe de sécurité). Ils restent néanmoins
# obligatoires : la défense en profondeur est un point d'audit du Bloc 2.

# Nom du bucket du data lake — valeur donnée par : terraform output nom_bucket
CREDISCORE_BUCKET=a-remplir
AWS_REGION=eu-north-1

# Feature store PostgreSQL
POSTGRES_UTILISATEUR=crediscore
POSTGRES_MOT_DE_PASSE=a-remplir-mot-de-passe-fort

# Interface Airflow
AIRFLOW_ADMIN_UTILISATEUR=admin
AIRFLOW_ADMIN_MOT_DE_PASSE=a-remplir-mot-de-passe-fort

# Interface Grafana
GRAFANA_ADMIN_UTILISATEUR=admin
GRAFANA_ADMIN_MOT_DE_PASSE=a-remplir-mot-de-passe-fort
