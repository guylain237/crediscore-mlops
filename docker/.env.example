# Gabarit des variables de la pile — copier en .env SUR LA VM et remplir.
# Le fichier .env réel n'est jamais versionné (voir .gitignore).
#
#   cp .env.example .env && nano .env
#
# Les mots de passe ci-dessous protègent des interfaces qui ne sont joignables
# que depuis l'IP administrateur (groupe de sécurité). Ils restent néanmoins
# obligatoires : la défense en profondeur fait partie des exigences de sécurité.

# Nom du bucket du data lake — valeur donnée par : terraform output datalake_bucket
CREDISCORE_BUCKET=a-remplir
AWS_REGION=eu-north-1

# Feature store PostgreSQL
POSTGRES_UTILISATEUR=crediscore
POSTGRES_MOT_DE_PASSE=a-remplir-mot-de-passe-fort

# Interface Airflow
AIRFLOW_ADMIN_UTILISATEUR=admin
AIRFLOW_ADMIN_MOT_DE_PASSE=a-remplir-mot-de-passe-fort

# Interface Grafana
GRAFANA_ADMIN_UTILISATEUR=admin
GRAFANA_ADMIN_MOT_DE_PASSE=a-remplir-mot-de-passe-fort

# Sel de pseudonymisation des identifiants dans les journaux (controle C-7).
# A generer une fois, puis ne plus changer : le modifier rendrait illisibles
# les pseudonymes des anciens journaux.
#   python -c "import secrets; print(secrets.token_hex(16))"
CREDISCORE_SEL_PSEUDO=a-remplir-par-une-valeur-aleatoire

# Memoire allouee a chaque job Spark, en Go. Les 8 jobs la lisent, et le DAG
# construction_variables la transmet a chacun.
#
# La VM a 2 vCPU partages avec onze conteneurs : trop haut, le noyau tue le job
# sans message clair ; trop bas, Spark passe son temps a ecrire sur disque.
# 3 est la valeur retenue sur cette machine.
CREDISCORE_MEMOIRE_GO=3
